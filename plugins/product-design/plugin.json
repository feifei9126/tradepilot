{
  "name": "product-design",
  "version": "1.0.0",
  "displayName": "产品设计",
  "description": "AI 商品图生成、产品描述模板、规格书导出、产品目录生成",
  "author": "TradePilot Team",
  "license": "MIT",
  "permissions": ["read:products", "write:products", "read:contacts", "api:outbound"],
  "hooks": ["product.afterCreate", "contact.afterCreate"],
  "settings": [
    { "key": "imageStyle", "type": "select", "label": "商品图风格", "defaultValue": "professional", "options": [
      { "label": "专业白底", "value": "professional" },
      { "label": "场景图", "value": "lifestyle" },
      { "label": "简约", "value": "minimal" }
    ]},
    { "key": "autoGenerateImages", "type": "boolean", "label": "自动生成商品图", "defaultValue": false },
    { "key": "defaultCatalogLang", "type": "select", "label": "产品目录语言", "defaultValue": "zh", "options": [
      { "label": "中文", "value": "zh" },
      { "label": "英文", "value": "en" },
      { "label": "中英双语", "value": "bilingual" }
    ]}
  ],
  "minAppVersion": "1.0.0"
}
