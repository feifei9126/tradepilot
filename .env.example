# 本地开发可使用默认演示账号；生产部署必须设置强凭据。
# Docker Compose 读取根目录 .env；Next.js 本地环境也可从 .env.local 读取。
AUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_URL=http://localhost:3458

# 生产环境必须修改；本地开发未配置时仍可使用 demo@tradepilot.dev / 12345678。
TRADEPILOT_ADMIN_EMAIL=admin@tradepilot.local
TRADEPILOT_ADMIN_PASSWORD=replace-with-a-strong-password

# 可选：启用团队注册与数据库账号登录。Cloudflare 部署应通过 wrangler secret put 设置。
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# TRADEPILOT_SEED_DEMO=false

# 外部消息 Webhook 的 Bearer 鉴权密钥。生产环境必须改为高强度随机值。
# 生成示例：openssl rand -hex 32
TRADEPILOT_WEBHOOK_SECRET=change-me-before-production

# npm start 会自动使用这个默认地址并同时启动 Worker；单独启动 Web 时可显式配置。
# OPENMONTAGE_WORKER_URL=http://localhost:8787

# MoneyPrinterTurbo API 地址。Docker Compose 会自动注入私有网络地址。
# MONEYPRINTERTURBO_URL=http://localhost:8080
# 上游启用 x-api-key 鉴权后再配置；不要暴露在 NEXT_PUBLIC_* 变量中。
# MONEYPRINTERTURBO_API_KEY=

# Firecrawl 页面抓取服务。可填写 Firecrawl Cloud API 或自托管 API 的地址。
# 自托管 API 默认端点应为 http://localhost:3002，TradePilot 只调用 /v1/scrape。
# FIRECRAWL_API_URL=http://localhost:3002
# FIRECRAWL_API_KEY=
# 本地地址可直接从产品页一键部署；远程服务器如需开放网页部署须显式启用。
# TRADEPILOT_ALLOW_SERVICE_DEPLOY=false
# 可选：修改一键部署的源码目录，默认 ~/.tradepilot/firecrawl。
# TRADEPILOT_FIRECRAWL_DIR=/path/to/firecrawl

# 产品视频任务持久化目录，Docker 默认挂载 /app/data。
# TRADEPILOT_DATA_DIR=./data

# 可选：启动 npm run video-worker 时使用。未配置外部命令时使用内置 FFmpeg 渲染真实 MP4。
# OPENMONTAGE_ADAPTER_PORT=8787
# OPENMONTAGE_ADAPTER_HOST=127.0.0.1
# OPENMONTAGE_WORKSPACE=/path/to/video-workspace
# OPENMONTAGE_PUBLIC_URL=https://video-worker.example.com

# 可选：用完整 OpenMontage 命令替换内置渲染器。
# OPENMONTAGE_REPO=/path/to/OpenMontage
# OPENMONTAGE_COMMAND=python3
# OPENMONTAGE_COMMAND_ARGS_JSON=["scripts/tradepilot_job.py","--job-file","{jobFile}","--output-dir","{outputDir}"]

# 可选：LiveKit AI 语音客服。Web 与独立 Agent Worker 必须使用同一项目。
# 配置步骤见 docs/livekit-agents.md。所有密钥仅服务端使用，禁止 NEXT_PUBLIC_*。
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_AGENT_NAME=tradepilot-customer-service
# 下列模型变量仅用于 Docker Compose 的 voice profile；本地运行放在 Worker 的 .env.local。
# OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Docker 本地试用默认仅监听本机；确认安全配置后才考虑对外开放。
# BIND_ADDRESS=127.0.0.1
# PORT=3456
# Docker 使用根目录 .env，且 AUTH_URL 应与访问地址一致（默认 http://localhost:3456）。

# 可选独立配置加密密钥，至少 32 字符；未设置则使用 AUTH_SECRET。
# 不要随意更换，否则已保存的 API 配置将无法解密。
# TRADEPILOT_CONFIG_KEY=
# Cloudflare 文件系统不提供配置持久化，详见 docs/cloudflare-deployment.md。
