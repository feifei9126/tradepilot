# 本地 Docker 试用配置。复制为 .env 后再启动：docker compose up -d --build
# .env 不要提交到 Git，也不要把任何服务端密钥放进 NEXT_PUBLIC_* 变量。
AUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_URL=http://localhost:3461

# 初始管理员密码由 install.sh 随机生成，首次登录必须修改。
# production 管理员至少 16 位、两类字符且不是公开示例；现有密码哈希不会被 env 覆盖。
TRADEPILOT_ADMIN_EMAIL=preview@tradepilot.local
TRADEPILOT_ADMIN_PASSWORD=replace-with-a-strong-password
TRADEPILOT_WORKSPACE_SLUG=tradepilot-admin

# Optional Prometheus scrape endpoint: GET /api/metrics with Authorization: Bearer <token>.
# Set a random value of at least 32 characters in your secret manager; unset/weak values disable the endpoint.
# METRICS_TOKEN=

# 登录共享限流保存在 PostgreSQL：默认不信任任何转发 IP，未验证来源共用一个桶。
# 只有可信代理剥离客户端同名头后重新设置 IP 和 x-tradepilot-proxy-auth，才启用：
# TRADEPILOT_TRUSTED_CLIENT_IP_HEADER=x-real-ip
# TRADEPILOT_PROXY_AUTH_SECRET=   # 至少 32 字符随机值，仅代理和 Web 服务持有

# 工作区 AI 的平台安全上限；实际执行取套餐、此上限、工作区预算的最低值。
# 0 禁用该类调用，非法值拒绝放行。不是模型服务商的货币账单。
AI_PLATFORM_MONTHLY_REQUEST_LIMIT=10000
AI_PLATFORM_MONTHLY_TOKEN_LIMIT=10000000
# 获客每日调用按 UTC 计数；每工作区需要在 AI 获客页面保存自己的 Cloud Key。
FIRECRAWL_TENANT_DAILY_REQUEST_LIMIT=20

# 邮箱 SMTP/IMAP 默认拒绝内网目标，只允许 TLS / 强制 STARTTLS。
# 平台自有内网邮箱的最小例外（精确 hostname -> RFC1918 IPv4；无通配符/元数据）：
# TRADEPILOT_MAIL_PRIVATE_ALLOWLIST='{"mail.corp.example":["10.0.0.5"]}'
# MARKETING_POLICY_VERSION=2026-10-07

# Stripe 配置；必须配置服务端套餐的 Price ID，并验收 sandbox 生命周期后再开通收费。
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Docker Compose 使用离散 PG* 变量，避免数据库密码中的 @、:、/、# 等字符破坏 URL。
# Docker 数据库服务会读取 POSTGRES_PASSWORD；应用和 db-init 会读取同一密码。
POSTGRES_PASSWORD=replace-with-a-local-password
# 本地直接运行 Next.js（不经过 Docker）时，可以改用 DATABASE_URL，或设置下列 PG* 变量：
# DATABASE_URL=postgresql://tradepilot:password@127.0.0.1:5432/tradepilot?sslmode=disable
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=tradepilot
# PGPASSWORD=replace-with-a-local-password
# PGDATABASE=tradepilot
# PGSSLMODE=disable
# 外部数据库应验证服务器身份，详见 docs/database-management.md：
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/run/secrets/postgres-ca.pem
# TRADEPILOT_DB_POOL_MAX=10
# TRADEPILOT_SEED_DEMO=false

# 旧版实例级 Webhook 已停用，填密钥也不会启用消息接收。
# 租户专属 HMAC 凭据/轮换/回放保护由工作区 Webhook 设置管理；业务分发尚待验收。
# TRADEPILOT_WEBHOOK_SECRET=

# Docker 本地试用默认仅监听本机；确认安全配置后才考虑对外开放。
BIND_ADDRESS=127.0.0.1
PORT=3461

# 部署管理员、实例 API 配置等本地文件目录，Docker 默认挂载 /app/data。
# 核心业务/视频任务元数据在 PostgreSQL；媒体在应用或 Worker 卷/S3，需分别备份。
# TRADEPILOT_DATA_DIR=./data

# 可选：启动 npm run video-worker 时使用。未配置外部命令时使用内置 FFmpeg 渲染真实 MP4。
# OPENMONTAGE_WORKER_URL=http://localhost:8787
# OPENMONTAGE_ADAPTER_PORT=8787
# OPENMONTAGE_ADAPTER_HOST=127.0.0.1
# OPENMONTAGE_WORKSPACE=/path/to/video-workspace
# OPENMONTAGE_PUBLIC_URL=https://video-worker.example.com

# MoneyPrinterTurbo API 地址。Docker Compose 会自动注入私有网络地址。
# MONEYPRINTERTURBO_URL=http://localhost:8080
# 上游启用 x-api-key 鉴权后再配置；不要暴露在 NEXT_PUBLIC_* 变量中。
# MONEYPRINTERTURBO_API_KEY=

# 下面仅为平台诊断/实例配置使用；租户搜索与产品导入不会回退到此共享 Key/地址。
# 租户 Firecrawl 固定使用 Cloud 地址和其自己的 Key。
# 自托管 API 默认端点应为 http://localhost:3002，TradePilot 只调用 /v1/scrape 和 /v1/search。
# FIRECRAWL_API_URL=http://localhost:3002
# FIRECRAWL_API_KEY=
# 本地地址可直接从产品页一键部署；远程服务器如需开放网页部署须显式启用。
# TRADEPILOT_ALLOW_SERVICE_DEPLOY=false
# 可选：修改一键部署的源码目录，默认 ~/.tradepilot/firecrawl。
# TRADEPILOT_FIRECRAWL_DIR=/path/to/firecrawl

# 可选：LiveKit AI 语音客服。Web 与独立 Agent Worker 必须使用同一项目。
# 配置步骤见 docs/livekit-agents.md。所有密钥仅服务端使用，禁止 NEXT_PUBLIC_*。
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_AGENT_NAME=tradepilot-customer-service
# OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# 可选独立配置加密密钥，至少 32 字符；未设置则使用 AUTH_SECRET。
# 不要随意更换，否则已保存的 API 配置将无法解密。
# TRADEPILOT_CONFIG_KEY=
# Cloudflare 文件系统不提供配置持久化，详见 docs/cloudflare-deployment.md。

# 媒体 / S3：未配置 S3 时在应用数据卷保存；元数据在 PostgreSQL。
# 只接受内容验证通过的图片、MP4/WebM、PDF；旧未验证内容强制下载。
# 上传读取实际流大小后才解析表单，但仍在内存中缓冲，非直接流式上传 S3。
# TRADEPILOT_MEDIA_MAX_BYTES=104857600
# 多副本须使用共享对象存储；请按压测结果设置更小的上传上限。
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_SERVER_SIDE_ENCRYPTION=AES256
