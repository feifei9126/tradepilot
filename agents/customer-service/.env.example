# Must point to the SAME LiveKit project as the TradePilot Web application.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
LIVEKIT_AGENT_NAME=tradepilot-customer-service

# Only this Worker needs the model key; never use NEXT_PUBLIC_* for secrets.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
